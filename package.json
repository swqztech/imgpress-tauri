{

  "name": "imgpress-tauri",

  "version": "1.0.0",

  "description": "轻图 - image compress and merge (Tauri)",

  "private": true,

  "type": "module",

  "scripts": {

    "dev": "tauri dev",

    "dev:serve": "vite",

    "build": "tsc -b && vite build",

    "build:client": "npm run build && npm run tauri build",

    "pack:portable": "node scripts/pack-portable.mjs",

    "pack:portable:build": "npm run build:client && node scripts/pack-portable.mjs",

    "tauri": "tauri",

    "typecheck": "tsc -b --pretty false"

  },

  "dependencies": {

    "@tauri-apps/api": "^2.2.0",

    "@tauri-apps/plugin-dialog": "^2.2.0",

    "react": "^19.2.1",

    "react-dom": "^19.2.1"

  },

  "devDependencies": {

    "@tauri-apps/cli": "^2.2.0",

    "@types/react": "^19.2.7",

    "@types/react-dom": "^19.2.3",

    "@vitejs/plugin-react": "^5.1.1",

    "typescript": "^5.9.3",

    "vite": "^7.2.6"

  }

}


